{
  "name": "gabrielveras.dev",
  "version": "2.1.18",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-github-pages-404.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "audit:overflow": "node scripts/audit-horizontal-overflow.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"*.{json,md}\"",
    "quality": "npm run lint && npm run format:check && npm run build",
    "sync:version": "node scripts/sync-version.mjs",
    "prestart": "npm run sync:version",
    "prebuild": "npm run sync:version",
    "prequality": "npm run sync:version",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "lint-staged": {
    "src/**/*.{ts,html,scss,json}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-server": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/ssr": "22.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
